---
interface Props {
  order: number;
  title: string;
  passages: string;
  shortDesc: string;
  category: string;
  slug: string;
  responseCount: number;
}

const { order, title, passages, shortDesc, category, slug, responseCount } = Astro.props;

const categoryColors: Record<string, string> = {
  'Old Testament': 'bg-amber-100 text-amber-800',
  'Gospels': 'bg-blue-100 text-blue-800',
  'Epistles': 'bg-purple-100 text-purple-800',
  'Old Testament / Theology': 'bg-amber-100 text-amber-800',
  'Prophets': 'bg-emerald-100 text-emerald-800',
  'Gospels / Textual Criticism': 'bg-blue-100 text-blue-800',
  'Acts / Theology': 'bg-indigo-100 text-indigo-800',
};

const colorClass = categoryColors[category] || 'bg-gray-100 text-gray-800';
---

<a href={`/${slug}`} class="group block">
  <article class="border border-gold/15 rounded-lg p-5 hover:border-gold/40 hover:shadow-md transition-all duration-200 bg-white/50">
    <div class="flex items-start gap-4">
      <span class="font-sans text-2xl font-bold text-gold/40 group-hover:text-gold/70 transition-colors leading-none mt-0.5 shrink-0">
        {String(order).padStart(2, '0')}
      </span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class={`font-sans text-xs font-medium px-2 py-0.5 rounded-full ${colorClass}`}>
            {category}
          </span>
        </div>
        <h3 class="font-sans font-semibold text-lg text-ink group-hover:text-gold transition-colors leading-snug">
          {title}
        </h3>
        <p class="font-sans text-sm text-ink-light mt-0.5">{passages}</p>
        <p class="text-base text-ink-light mt-2 leading-relaxed">{shortDesc}</p>
        <p class="font-sans text-xs text-ink-light/70 mt-2">
          {responseCount} {responseCount === 1 ? 'response' : 'responses'}
        </p>
      </div>
    </div>
  </article>
</a>
